# Password tunggal untuk dashboard /admin
ADMIN_PASSWORD=ganti-password-ini

# Kunci untuk tanda tangan cookie sesi admin (string acak panjang)
SESSION_SECRET=ganti-dengan-string-acak-panjang

# URL Web App Apps Script yang berakhiran /exec (lihat google-apps-script/Code.gs)
SHEETS_WEBAPP_URL=https://script.google.com/macros/s/xxxxxxxxxxxxxxxxxxxx/exec

# Baris SHARED_SECRET yang dicetak saat menjalankan setup() di Apps Script
SHEETS_SHARED_SECRET=ganti-dengan-secret-dari-log-setup
